# Copy to ovh_inventory_wea28.op.env (gitignored) or pass via `op run --env-file`.
# Requires: op CLI or OP_SERVICE_ACCOUNT_TOKEN + onepassword-sdk for op:// resolution.

# Recommended (full inventory — juin 2026):
OVH_APPLICATION_KEY=op://Replit/OVH_WeAdU_Unlimited/Application Key
OVH_APPLICATION_SECRET=op://Replit/OVH_WeAdU_Unlimited/Application Secret
OVH_CONSUMER_KEY=op://Replit/OVH_WeAdU_Unlimited/Consumer Key

